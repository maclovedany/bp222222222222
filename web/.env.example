# .env.local로 복사해 채운다. Vercel에는 위 4개(공공데이터 키·Aside 제외)를 환경변수로 넣는다.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio에서 발급
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- 아래는 Mac 수집 워커 전용 ---
# 공공데이터포털 "소상공인시장진흥공단_상가(상권)정보" 활용신청 후 받은 일반 인증키(Decoding)
DATA_GO_KR_KEY=
# 비워두면 Aside 기본 프로필을 쓴다. 목록: aside host profiles
ASIDE_PROFILE=
